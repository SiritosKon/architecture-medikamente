<mxfile host="drawio" type="device"><diagram id="Ishikawa" name="Ishikawa"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Диаграмма Исикавы: причины узких мест производительности при миграции «Медикаменте» на микросервисную архитектуру" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="2600" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Эффект — справа. 8 категорий причин; коды (I1, D3…) соответствуют разделам отчёта Task4/README.md. Красным выделены причины с приоритетом P1." style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="34" width="2600" height="24" as="geometry"/></mxCell><mxCell id="c4" value="" style="html=1;endArrow=block;endFill=1;strokeWidth=4;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="640" as="sourcePoint"/><mxPoint x="2300" y="640" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c5" value="&lt;b&gt;ЭФФЕКТ:&lt;/b&gt;&lt;br&gt;деградация производительности и узкие места новой системы после миграции (рост latency записи, таймауты, недоступность при ×5 нагрузке)" style="shape=step;perimeter=stepPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=30;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="2300" y="550" width="320" height="180" as="geometry"/></mxCell><mxCell id="c6" value="" style="html=1;endArrow=none;strokeWidth=2;strokeColor=#6c8ebf;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="200" y="170" as="sourcePoint"/><mxPoint x="560" y="640" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c7" value="1. Инфраструктура" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="70" y="120" width="260" height="44" as="geometry"/></mxCell><mxCell id="c8" value="" style="html=1;endArrow=none;strokeWidth=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="213.2" y="226.4" as="sourcePoint"/><mxPoint x="243.2" y="226.4" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c9" value='&lt;font color="#b00000"&gt;I1. Один физический сервер в офисе: нет ресурса на параллельную работу старой и новой системы&lt;/font&gt;' style="text;html=1;align=right;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="-86.80000000000001" y="196.4" width="296" height="58" as="geometry"/></mxCell><mxCell id="c10" value="" style="html=1;endArrow=none;strokeWidth=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="285.2" y="320.4" as="sourcePoint"/><mxPoint x="315.2" y="320.4" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c11" value='&lt;font color="#222222"&gt;I2. Канал офис/филиалы ↔ облако: полоса и задержка ГОСТ VPN&lt;/font&gt;' style="text;html=1;align=right;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="-14.800000000000011" y="290.4" width="296" height="58" as="geometry"/></mxCell><mxCell id="c12" value="" style="html=1;endArrow=none;strokeWidth=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="357.20000000000005" y="414.4" as="sourcePoint"/><mxPoint x="387.20000000000005" y="414.4" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c13" value='&lt;font color="#222222"&gt;I3. Нет нагрузочного и DR-стенда&lt;/font&gt;' style="text;html=1;align=right;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="57.200000000000045" y="384.4" width="296" height="58" as="geometry"/></mxCell><mxCell id="c14" value="" style="html=1;endArrow=none;strokeWidth=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="429.20000000000005" y="508.40000000000003" as="sourcePoint"/><mxPoint x="459.20000000000005" y="508.40000000000003" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c15" value='&lt;font color="#222222"&gt;I4. Недостаток IOPS у СУБД на шифрованных томах&lt;/font&gt;' style="text;html=1;align=right;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="129.20000000000005" y="478.40000000000003" width="296" height="58" as="geometry"/></mxCell><mxCell id="c16" value="" style="html=1;endArrow=none;strokeWidth=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="501.20000000000005" y="602.4000000000001" as="sourcePoint"/><mxPoint x="531.2" y="602.4000000000001" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c17" value='&lt;font color="#222222"&gt;I5. K8s без лимитов и автоскейлинга: «шумные соседи»&lt;/font&gt;' style="text;html=1;align=right;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="201.20000000000005" y="572.4000000000001" width="296" height="58" as="geometry"/></mxCell><mxCell id="c18" value="" style="html=1;endArrow=none;strokeWidth=2;strokeColor=#6c8ebf;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="170" as="sourcePoint"/><mxPoint x="1080" y="640" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c19" value="2. Данные и БД" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="590" y="120" width="260" height="44" as="geometry"/></mxCell><mxCell id="c20" value="" style="html=1;endArrow=none;strokeWidth=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="733.2" y="226.4" as="sourcePoint"/><mxPoint x="763.2" y="226.4" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c21" value='&lt;font color="#b00000"&gt;D1. Грязные Excel и сканы: дубли пациентов, долгий матчинг MPI&lt;/font&gt;' style="text;html=1;align=right;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="433.20000000000005" y="196.4" width="296" height="58" as="geometry"/></mxCell><mxCell id="c22" value="" style="html=1;endArrow=none;strokeWidth=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="805.2" y="320.4" as="sourcePoint"/><mxPoint x="835.2" y="320.4" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c23" value='&lt;font color="#222222"&gt;D2. Общие ресурсы монолита / файловая 1С: блокировки&lt;/font&gt;' style="text;html=1;align=right;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="505.20000000000005" y="290.4" width="296" height="58" as="geometry"/></mxCell><mxCell id="c24" value="" style="html=1;endArrow=none;strokeWidth=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="877.2" y="414.4" as="sourcePoint"/><mxPoint x="907.2" y="414.4" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c25" value='&lt;font color="#b00000"&gt;D3. Поиск по зашифрованным полям (телефон, ФИО) без blind index → full scan&lt;/font&gt;' style="text;html=1;align=right;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="577.2" y="384.4" width="296" height="58" as="geometry"/></mxCell><mxCell id="c26" value="" style="html=1;endArrow=none;strokeWidth=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="949.2" y="508.40000000000003" as="sourcePoint"/><mxPoint x="979.2" y="508.40000000000003" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c27" value='&lt;font color="#222222"&gt;D4. Рост ×5 без партиционирования (записи, аудит)&lt;/font&gt;' style="text;html=1;align=right;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="649.2" y="478.40000000000003" width="296" height="58" as="geometry"/></mxCell><mxCell id="c28" value="" style="html=1;endArrow=none;strokeWidth=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1021.2" y="602.4000000000001" as="sourcePoint"/><mxPoint x="1051.2" y="602.4000000000001" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c29" value='&lt;font color="#222222"&gt;D5. Dual write в переходный период → рассинхронизация&lt;/font&gt;' style="text;html=1;align=right;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="721.2" y="572.4000000000001" width="296" height="58" as="geometry"/></mxCell><mxCell id="c30" value="" style="html=1;endArrow=none;strokeWidth=2;strokeColor=#6c8ebf;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1240" y="170" as="sourcePoint"/><mxPoint x="1600" y="640" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c31" value="3. Архитектура и ПО" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1110" y="120" width="260" height="44" as="geometry"/></mxCell><mxCell id="c32" value="" style="html=1;endArrow=none;strokeWidth=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1253.2" y="226.4" as="sourcePoint"/><mxPoint x="1283.2" y="226.4" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c33" value='&lt;font color="#b00000"&gt;A1. «Болтливые» синхронные вызовы между сервисами, N+1&lt;/font&gt;' style="text;html=1;align=right;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="953.2" y="196.4" width="296" height="58" as="geometry"/></mxCell><mxCell id="c34" value="" style="html=1;endArrow=none;strokeWidth=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1325.2" y="320.4" as="sourcePoint"/><mxPoint x="1355.2" y="320.4" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c35" value='&lt;font color="#b00000"&gt;A2. Запись + оплата без саги: распределённые блокировки и таймауты&lt;/font&gt;' style="text;html=1;align=right;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1025.2" y="290.4" width="296" height="58" as="geometry"/></mxCell><mxCell id="c36" value="" style="html=1;endArrow=none;strokeWidth=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1397.2" y="414.4" as="sourcePoint"/><mxPoint x="1427.2" y="414.4" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c37" value='&lt;font color="#222222"&gt;A3. Неверные границы доменов → распределённый монолит&lt;/font&gt;' style="text;html=1;align=right;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1097.2" y="384.4" width="296" height="58" as="geometry"/></mxCell><mxCell id="c38" value="" style="html=1;endArrow=none;strokeWidth=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1469.2" y="508.40000000000003" as="sourcePoint"/><mxPoint x="1499.2" y="508.40000000000003" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c39" value='&lt;font color="#222222"&gt;A4. Нет кэша расписания и справочников&lt;/font&gt;' style="text;html=1;align=right;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1169.2" y="478.40000000000003" width="296" height="58" as="geometry"/></mxCell><mxCell id="c40" value="" style="html=1;endArrow=none;strokeWidth=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1541.2" y="602.4000000000001" as="sourcePoint"/><mxPoint x="1571.2" y="602.4000000000001" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c41" value='&lt;font color="#222222"&gt;A5. Пулы соединений и JVM не настроены, холодный старт&lt;/font&gt;' style="text;html=1;align=right;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1241.2" y="572.4000000000001" width="296" height="58" as="geometry"/></mxCell><mxCell id="c42" value="" style="html=1;endArrow=none;strokeWidth=2;strokeColor=#6c8ebf;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1760" y="170" as="sourcePoint"/><mxPoint x="2120" y="640" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c43" value="4. Интеграции" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1630" y="120" width="260" height="44" as="geometry"/></mxCell><mxCell id="c44" value="" style="html=1;endArrow=none;strokeWidth=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1773.2" y="226.4" as="sourcePoint"/><mxPoint x="1803.2" y="226.4" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c45" value='&lt;font color="#b00000"&gt;G1. ККТ через OLE-компоненту 1С: синхронно, однопоточно&lt;/font&gt;' style="text;html=1;align=right;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1473.2" y="196.4" width="296" height="58" as="geometry"/></mxCell><mxCell id="c46" value="" style="html=1;endArrow=none;strokeWidth=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1845.2" y="320.4" as="sourcePoint"/><mxPoint x="1875.2" y="320.4" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c47" value='&lt;font color="#222222"&gt;G2. Обмен с файловой 1С: медленные выгрузки, блокировки&lt;/font&gt;' style="text;html=1;align=right;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1545.2" y="290.4" width="296" height="58" as="geometry"/></mxCell><mxCell id="c48" value="" style="html=1;endArrow=none;strokeWidth=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1917.2" y="414.4" as="sourcePoint"/><mxPoint x="1947.2" y="414.4" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c49" value='&lt;font color="#222222"&gt;G3. Rate limits SMS / voice, лаборатории, ПСП, ЕСИА&lt;/font&gt;' style="text;html=1;align=right;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1617.2" y="384.4" width="296" height="58" as="geometry"/></mxCell><mxCell id="c50" value="" style="html=1;endArrow=none;strokeWidth=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1989.2" y="508.40000000000003" as="sourcePoint"/><mxPoint x="2019.2" y="508.40000000000003" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c51" value='&lt;font color="#b00000"&gt;G4. Напоминания «за день» одним батчем → пик&lt;/font&gt;' style="text;html=1;align=right;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1689.2" y="478.40000000000003" width="296" height="58" as="geometry"/></mxCell><mxCell id="c52" value="" style="html=1;endArrow=none;strokeWidth=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2061.2" y="602.4000000000001" as="sourcePoint"/><mxPoint x="2091.2" y="602.4000000000001" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c53" value='&lt;font color="#222222"&gt;G5. Нет идемпотентности и backoff → шторм ретраев&lt;/font&gt;' style="text;html=1;align=right;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1761.1999999999998" y="572.4000000000001" width="296" height="58" as="geometry"/></mxCell><mxCell id="c54" value="" style="html=1;endArrow=none;strokeWidth=2;strokeColor=#6c8ebf;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="200" y="1110" as="sourcePoint"/><mxPoint x="560" y="640" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c55" value="5. Безопасность (overhead)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="70" y="1115" width="260" height="44" as="geometry"/></mxCell><mxCell id="c56" value="" style="html=1;endArrow=none;strokeWidth=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="213.2" y="1053.6" as="sourcePoint"/><mxPoint x="243.2" y="1053.6" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c57" value='&lt;font color="#b00000"&gt;S1. Синхронный OPA / Vault на каждый запрос → +latency&lt;/font&gt;' style="text;html=1;align=right;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="-86.80000000000001" y="1023.5999999999999" width="296" height="58" as="geometry"/></mxCell><mxCell id="c58" value="" style="html=1;endArrow=none;strokeWidth=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="285.2" y="959.6" as="sourcePoint"/><mxPoint x="315.2" y="959.6" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c59" value='&lt;font color="#b00000"&gt;S2. Аудит каждого чтения → write amplification (Kafka, ClickHouse)&lt;/font&gt;' style="text;html=1;align=right;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="-14.800000000000011" y="929.6" width="296" height="58" as="geometry"/></mxCell><mxCell id="c60" value="" style="html=1;endArrow=none;strokeWidth=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="357.20000000000005" y="865.6" as="sourcePoint"/><mxPoint x="387.20000000000005" y="865.6" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c61" value='&lt;font color="#222222"&gt;S3. Массовая детокенизация в списках ресепшена&lt;/font&gt;' style="text;html=1;align=right;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="57.200000000000045" y="835.6" width="296" height="58" as="geometry"/></mxCell><mxCell id="c62" value="" style="html=1;endArrow=none;strokeWidth=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="429.20000000000005" y="771.5999999999999" as="sourcePoint"/><mxPoint x="459.20000000000005" y="771.5999999999999" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c63" value='&lt;font color="#222222"&gt;S4. TLS / mTLS / ГОСТ TLS handshake без keep-alive → CPU&lt;/font&gt;' style="text;html=1;align=right;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="129.20000000000005" y="741.5999999999999" width="296" height="58" as="geometry"/></mxCell><mxCell id="c64" value="" style="html=1;endArrow=none;strokeWidth=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="501.20000000000005" y="677.5999999999999" as="sourcePoint"/><mxPoint x="531.2" y="677.5999999999999" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c65" value='&lt;font color="#222222"&gt;S5. Тяжёлый Privacy Pipeline (k-анонимность, NER)&lt;/font&gt;' style="text;html=1;align=right;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="201.20000000000005" y="647.5999999999999" width="296" height="58" as="geometry"/></mxCell><mxCell id="c66" value="" style="html=1;endArrow=none;strokeWidth=2;strokeColor=#6c8ebf;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="1110" as="sourcePoint"/><mxPoint x="1080" y="640" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c67" value="6. Персонал" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="590" y="1115" width="260" height="44" as="geometry"/></mxCell><mxCell id="c68" value="" style="html=1;endArrow=none;strokeWidth=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="733.2" y="1053.6" as="sourcePoint"/><mxPoint x="763.2" y="1053.6" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c69" value='&lt;font color="#b00000"&gt;H1. IT-отдел 3 человека, bus factor = 1 (CTO)&lt;/font&gt;' style="text;html=1;align=right;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="433.20000000000005" y="1023.5999999999999" width="296" height="58" as="geometry"/></mxCell><mxCell id="c70" value="" style="html=1;endArrow=none;strokeWidth=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="805.2" y="959.6" as="sourcePoint"/><mxPoint x="835.2" y="959.6" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c71" value='&lt;font color="#222222"&gt;H2. Нет опыта эксплуатации K8s / Kafka под нагрузкой, нет SRE&lt;/font&gt;' style="text;html=1;align=right;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="505.20000000000005" y="929.6" width="296" height="58" as="geometry"/></mxCell><mxCell id="c72" value="" style="html=1;endArrow=none;strokeWidth=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="877.2" y="865.6" as="sourcePoint"/><mxPoint x="907.2" y="865.6" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c73" value='&lt;font color="#222222"&gt;H3. Нет DBA и специалиста ИБ&lt;/font&gt;' style="text;html=1;align=right;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="577.2" y="835.6" width="296" height="58" as="geometry"/></mxCell><mxCell id="c74" value="" style="html=1;endArrow=none;strokeWidth=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="949.2" y="771.5999999999999" as="sourcePoint"/><mxPoint x="979.2" y="771.5999999999999" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c75" value='&lt;font color="#222222"&gt;H4. Сотрудники параллельно работают в Excel&lt;/font&gt;' style="text;html=1;align=right;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="649.2" y="741.5999999999999" width="296" height="58" as="geometry"/></mxCell><mxCell id="c76" value="" style="html=1;endArrow=none;strokeWidth=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1021.2" y="677.5999999999999" as="sourcePoint"/><mxPoint x="1051.2" y="677.5999999999999" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c77" value='&lt;font color="#222222"&gt;H5. Массовый найм: пользователи без обучения&lt;/font&gt;' style="text;html=1;align=right;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="721.2" y="647.5999999999999" width="296" height="58" as="geometry"/></mxCell><mxCell id="c78" value="" style="html=1;endArrow=none;strokeWidth=2;strokeColor=#6c8ebf;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1240" y="1110" as="sourcePoint"/><mxPoint x="1600" y="640" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c79" value="7. Процессы" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1110" y="1115" width="260" height="44" as="geometry"/></mxCell><mxCell id="c80" value="" style="html=1;endArrow=none;strokeWidth=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1253.2" y="1053.6" as="sourcePoint"/><mxPoint x="1283.2" y="1053.6" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c81" value='&lt;font color="#b00000"&gt;R1. Нет нагрузочного тестирования, SLO и бюджета ошибок&lt;/font&gt;' style="text;html=1;align=right;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="953.2" y="1023.5999999999999" width="296" height="58" as="geometry"/></mxCell><mxCell id="c82" value="" style="html=1;endArrow=none;strokeWidth=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1325.2" y="959.6" as="sourcePoint"/><mxPoint x="1355.2" y="959.6" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c83" value='&lt;font color="#b00000"&gt;R2. Миграция «big bang» вместо Strangler Fig&lt;/font&gt;' style="text;html=1;align=right;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1025.2" y="929.6" width="296" height="58" as="geometry"/></mxCell><mxCell id="c84" value="" style="html=1;endArrow=none;strokeWidth=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1397.2" y="865.6" as="sourcePoint"/><mxPoint x="1427.2" y="865.6" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c85" value='&lt;font color="#222222"&gt;R3. Нет baseline-метрик As-Is — не с чем сравнить&lt;/font&gt;' style="text;html=1;align=right;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1097.2" y="835.6" width="296" height="58" as="geometry"/></mxCell><mxCell id="c86" value="" style="html=1;endArrow=none;strokeWidth=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1469.2" y="771.5999999999999" as="sourcePoint"/><mxPoint x="1499.2" y="771.5999999999999" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c87" value='&lt;font color="#222222"&gt;R4. Нет capacity planning под открытие филиалов&lt;/font&gt;' style="text;html=1;align=right;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1169.2" y="741.5999999999999" width="296" height="58" as="geometry"/></mxCell><mxCell id="c88" value="" style="html=1;endArrow=none;strokeWidth=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1541.2" y="677.5999999999999" as="sourcePoint"/><mxPoint x="1571.2" y="677.5999999999999" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c89" value='&lt;font color="#222222"&gt;R5. Ручные релизы без canary и feature flags&lt;/font&gt;' style="text;html=1;align=right;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1241.2" y="647.5999999999999" width="296" height="58" as="geometry"/></mxCell><mxCell id="c90" value="" style="html=1;endArrow=none;strokeWidth=2;strokeColor=#6c8ebf;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1760" y="1110" as="sourcePoint"/><mxPoint x="2120" y="640" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c91" value="8. Нагрузка и бизнес" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1630" y="1115" width="260" height="44" as="geometry"/></mxCell><mxCell id="c92" value="" style="html=1;endArrow=none;strokeWidth=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1773.2" y="1053.6" as="sourcePoint"/><mxPoint x="1803.2" y="1053.6" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c93" value='&lt;font color="#b00000"&gt;B1. Пики записи: утро понедельника, открытие расписания&lt;/font&gt;' style="text;html=1;align=right;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1473.2" y="1023.5999999999999" width="296" height="58" as="geometry"/></mxCell><mxCell id="c94" value="" style="html=1;endArrow=none;strokeWidth=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1845.2" y="959.6" as="sourcePoint"/><mxPoint x="1875.2" y="959.6" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c95" value='&lt;font color="#222222"&gt;B2. Всплески трафика от push-рассылок мобильного приложения&lt;/font&gt;' style="text;html=1;align=right;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1545.2" y="929.6" width="296" height="58" as="geometry"/></mxCell><mxCell id="c96" value="" style="html=1;endArrow=none;strokeWidth=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1917.2" y="865.6" as="sourcePoint"/><mxPoint x="1947.2" y="865.6" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c97" value='&lt;font color="#222222"&gt;B3. Открытие филиалов волнами → скачок нагрузки&lt;/font&gt;' style="text;html=1;align=right;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1617.2" y="835.6" width="296" height="58" as="geometry"/></mxCell><mxCell id="c98" value="" style="html=1;endArrow=none;strokeWidth=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1989.2" y="771.5999999999999" as="sourcePoint"/><mxPoint x="2019.2" y="771.5999999999999" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c99" value='&lt;font color="#222222"&gt;B4. Сезонность: ОРВИ, диспансеризация&lt;/font&gt;' style="text;html=1;align=right;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1689.2" y="741.5999999999999" width="296" height="58" as="geometry"/></mxCell><mxCell id="c100" value="" style="html=1;endArrow=none;strokeWidth=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2061.2" y="677.5999999999999" as="sourcePoint"/><mxPoint x="2091.2" y="677.5999999999999" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c101" value='&lt;font color="#222222"&gt;B5. Аналитика / ML на тех же ресурсах, что и OLTP&lt;/font&gt;' style="text;html=1;align=right;verticalAlign=middle;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1761.1999999999998" y="647.5999999999999" width="296" height="58" as="geometry"/></mxCell><mxCell id="c102" value="&lt;b&gt;Приоритет мер&lt;/b&gt; (см. отчёт): P1 — до запуска MVP · P2 — до открытия второго филиала · P3 — к финальному состоянию" style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="1200" width="1400" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>