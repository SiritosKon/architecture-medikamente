<mxfile host="drawio" type="device"><diagram id="C4-Context" name="C4-Context"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="C4 Level 1 — System Context. Целевое состояние «Медикаменте» (Privacy by Design)" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="10" y="0" width="1900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Все системы — в защищённом контуре в РФ (152-ФЗ ст.18 ч.5). &lt;b&gt;Privacy &amp; Security Platform&lt;/b&gt; — сквозной слой: каждая система получает аутентификацию, авторизацию, ключи, проверку согласий и аудит через него. &lt;b&gt;Аналитическая платформа&lt;/b&gt; получает данные только через конвейер обезличивания." style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="10" y="32" width="1900" height="40" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b&gt;Пациент&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;[Person]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;Запись, ЛК, анализы, оплата, согласия&lt;/span&gt;' style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;" vertex="1" parent="1"><mxGeometry x="290" y="90" width="170" height="130" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;Ресепшен&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;[Person]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;Расписание филиала, договоры&lt;/span&gt;' style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;" vertex="1" parent="1"><mxGeometry x="520" y="90" width="170" height="130" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b&gt;Медицинский специалист&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;[Person]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;Приём, EHR, направления&lt;/span&gt;' style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;" vertex="1" parent="1"><mxGeometry x="710" y="90" width="170" height="130" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;Кассир&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;[Person]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;Оплата на месте&lt;/span&gt;' style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;" vertex="1" parent="1"><mxGeometry x="900" y="90" width="170" height="130" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b&gt;Бухгалтерия / HR&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;[Person]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;Учёт, зарплата, отчётность&lt;/span&gt;' style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;" vertex="1" parent="1"><mxGeometry x="1330" y="90" width="170" height="130" as="geometry"/></mxCell><mxCell id="c9" value='&lt;b&gt;Аналитик / руководство&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;[Person]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;BI, ML, отчёты&lt;/span&gt;' style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;" vertex="1" parent="1"><mxGeometry x="20" y="900" width="170" height="130" as="geometry"/></mxCell><mxCell id="c10" value='&lt;b&gt;DPO / офицер ИБ&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;[Person]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;Политики, инциденты, запросы субъектов&lt;/span&gt;' style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;" vertex="1" parent="1"><mxGeometry x="1690" y="920" width="170" height="130" as="geometry"/></mxCell><mxCell id="c11" value="Медикаменте — корпоративный контур (облако / ЦОД в РФ, аттестован под УЗ-2)" style="rounded=1;fontSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;arcSize=2;fillColor=none;strokeColor=#444444;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="250" y="260" width="1370" height="800" as="geometry"/></mxCell><mxCell id="c12" value='&lt;b&gt;Клиентские каналы&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;[Software System]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;Портал пациента и мобильное приложение: запись, ЛК, результаты, оплата, согласия&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1061B0;fontColor=#ffffff;align=center;arcSize=8;strokeColor=#0D5091;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="300" width="260" height="120" as="geometry"/></mxCell><mxCell id="c13" value='&lt;b&gt;Порталы сотрудников&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;[Software System]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;Портал ресепшена, АРМ врача (EHR UI), АРМ кассира&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1061B0;fontColor=#ffffff;align=center;arcSize=8;strokeColor=#0D5091;fontSize=11;" vertex="1" parent="1"><mxGeometry x="640" y="300" width="260" height="120" as="geometry"/></mxCell><mxCell id="c14" value='&lt;b&gt;Интеграционный слой&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;[Software System]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;API Gateway, Partner API Gateway, шина событий Kafka (схемы с тегами)&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1061B0;fontColor=#ffffff;align=center;arcSize=8;strokeColor=#0D5091;fontSize=11;" vertex="1" parent="1"><mxGeometry x="980" y="300" width="260" height="120" as="geometry"/></mxCell><mxCell id="c15" value='&lt;b&gt;1С: БП / ЗУП / УТ&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;[Software System, legacy]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;Клиент-серверный режим на Postgres, защищённый сегмент&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;fontColor=#ffffff;align=center;arcSize=8;strokeColor=#666666;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="1320" y="300" width="260" height="120" as="geometry"/></mxCell><mxCell id="c16" value='&lt;b&gt;Медицинская платформа (МИС)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;[Software System]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;Реестр пациентов (MPI), расписание, EHR, лабораторные заказы, CRM, уведомления&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1061B0;fontColor=#ffffff;align=center;arcSize=8;strokeColor=#0D5091;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="500" width="600" height="130" as="geometry"/></mxCell><mxCell id="c17" value='&lt;b&gt;Платёжный шлюз&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;[Software System]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;Онлайн-оплата через ПСП (PAN не входит в контур), касса, фискализация&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1061B0;fontColor=#ffffff;align=center;arcSize=8;strokeColor=#0D5091;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1320" y="500" width="260" height="130" as="geometry"/></mxCell><mxCell id="c18" value='&lt;b&gt;Privacy &amp; Security Platform&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;[Software System — Privacy by Design]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;IAM (Keycloak + OPA: RBAC/ABAC) · Consent &amp; Privacy Requests · Vault/HSM (KMS, токенизация) · Data Catalog: теги + Lineage · Audit Log (WORM) → SIEM/UEBA · DLP · Privacy Gate в CI/CD · Retention &amp; Erasure (crypto-shredding)&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6a3d9a;fontColor=#ffffff;align=center;arcSize=8;strokeColor=#4b2a70;fontSize=11;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="300" y="700" width="1280" height="120" as="geometry"/></mxCell><mxCell id="c19" value='&lt;b&gt;Аналитическая платформа (privacy-preserving)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;[Software System]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;CDC → Privacy Pipeline (псевдонимизация, k-анонимность) → Data Lake → витрины → BI / ML / LLM&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1b7f5a;fontColor=#ffffff;align=center;arcSize=8;strokeColor=#125a40;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="900" width="600" height="120" as="geometry"/></mxCell><mxCell id="c20" value='&lt;b&gt;Мониторинг и алертинг&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;[Software System]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;VictoriaMetrics, Grafana, Alertmanager, Elastic (логи с маскированием)&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1061B0;fontColor=#ffffff;align=center;arcSize=8;strokeColor=#0D5091;fontSize=11;" vertex="1" parent="1"><mxGeometry x="980" y="900" width="600" height="120" as="geometry"/></mxCell><mxCell id="c21" value='&lt;b&gt;Банк (DirectBank), ФНС/СФР&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;[External System]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;Зарплата, отчётность (КЭП)&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=8;strokeColor=#736782;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1690" y="320" width="210" height="80" as="geometry"/></mxCell><mxCell id="c22" value='&lt;b&gt;Лаборатория-партнёр&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;[External System]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;Заказы и результаты по API&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=8;strokeColor=#736782;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1690" y="420" width="210" height="80" as="geometry"/></mxCell><mxCell id="c23" value='&lt;b&gt;ПСП / банк-эквайер&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;[External System]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;Приём карт (PCI DSS)&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=8;strokeColor=#736782;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1690" y="520" width="210" height="80" as="geometry"/></mxCell><mxCell id="c24" value='&lt;b&gt;ОФД → ФНС&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;[External System]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;Фискальные чеки (54-ФЗ)&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=8;strokeColor=#736782;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1690" y="620" width="210" height="80" as="geometry"/></mxCell><mxCell id="c25" value='&lt;b&gt;ЕСИА (Госуслуги)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;[External System]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;Вход пациента&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=8;strokeColor=#736782;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1690" y="720" width="210" height="80" as="geometry"/></mxCell><mxCell id="c26" value='&lt;b&gt;РКН / НКЦКИ&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;[External System]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;Уведомление об инцидентах (24/72 ч)&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=8;strokeColor=#736782;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1690" y="820" width="210" height="80" as="geometry"/></mxCell><mxCell id="c27" value='&lt;b&gt;SMS / Push / голосовой робот&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;[External System]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;Напоминания, подтверждения&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=8;strokeColor=#736782;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="500" width="210" height="80" as="geometry"/></mxCell><mxCell id="c28" value='&lt;b&gt;ЕГИСЗ (перспектива)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;[External System]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;Обмен медицинскими документами&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=8;strokeColor=#736782;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="610" width="210" height="80" as="geometry"/></mxCell><mxCell id="c29" value="HTTPS / приложение" style="html=1;endArrow=block;endFill=1;strokeColor=#707070;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#707070;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="SSO + MFA" style="html=1;endArrow=block;endFill=1;strokeColor=#707070;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c6" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#707070;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c7" target="c13"><mxGeometry relative="1" as=