<mxfile host="drawio" type="device"><diagram id="C4-Container" name="C4-Container"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="C4 Level 2 — Container. Целевая архитектура «Медикаменте»: MVP (оранжевая рамка) и финальное состояние" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="10" y="0" width="2450" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;MVP (~2 мес.):&lt;/b&gt; самостоятельная запись через портал, запись видна ресепшену, напоминание пациенту и специалисту за день — сразу с IAM, RBAC/ABAC, шифрованием, согласиями и аудитом. &lt;b&gt;Финал (~1 год):&lt;/b&gt; мобильное приложение, голосовой робот, EHR, лаборатория, платёжный шлюз, CRM, UEBA, privacy gate, аналитика." style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="10" y="32" width="2450" height="40" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b&gt;Пациент&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;[Person]&lt;/span&gt;' style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;" vertex="1" parent="1"><mxGeometry x="335" y="80" width="170" height="130" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;Ресепшен&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;[Person]&lt;/span&gt;' style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;" vertex="1" parent="1"><mxGeometry x="750" y="80" width="170" height="120" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b&gt;Врач&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;[Person]&lt;/span&gt;' style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;" vertex="1" parent="1"><mxGeometry x="1000" y="80" width="170" height="120" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;Кассир&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;[Person]&lt;/span&gt;' style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;" vertex="1" parent="1"><mxGeometry x="1250" y="80" width="170" height="120" as="geometry"/></mxCell><mxCell id="c8" value="Каналы → API Gateway: HTTPS, TLS 1.3, OIDC access token (все каналы)" style="rounded=1;fontSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;arcSize=2;fillColor=#eef5fc;strokeColor=#0D5091;fontColor=#0D5091;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="200" y="240" width="1250" height="140" as="geometry"/></mxCell><mxCell id="c9" value='&lt;b&gt;Портал пациента&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;[SPA, React]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;запись, ЛК&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=8;strokeColor=#e8a202;strokeWidth=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="220" y="280" width="230" height="80" as="geometry"/></mxCell><mxCell id="c10" value='&lt;b&gt;Мобильное приложение&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;[iOS / Android]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;ЛК, push, подтверждение&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=8;strokeColor=#0E7DAD;fontSize=10;" vertex="1" parent="1"><mxGeometry x="470" y="280" width="230" height="80" as="geometry"/></mxCell><mxCell id="c11" value='&lt;b&gt;Портал ресепшена&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;[SPA]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;расписание филиала (маскировано)&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=8;strokeColor=#e8a202;strokeWidth=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="720" y="280" width="230" height="80" as="geometry"/></mxCell><mxCell id="c12" value='&lt;b&gt;АРМ врача&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;[SPA]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;EHR UI, только свои пациенты&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=8;strokeColor=#0E7DAD;fontSize=10;" vertex="1" parent="1"><mxGeometry x="970" y="280" width="230" height="80" as="geometry"/></mxCell><mxCell id="c13" value='&lt;b&gt;АРМ кассира&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;[SPA + драйвер ККТ]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;VLAN кассы&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=8;strokeColor=#0E7DAD;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1220" y="280" width="230" height="80" as="geometry"/></mxCell><mxCell id="c14" value="Периметр (DMZ)" style="rounded=1;fontSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;arcSize=2;fillColor=#eef5fc;strokeColor=#0D5091;fontColor=#0D5091;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1450" y="240" width="770" height="140" as="geometry"/></mxCell><mxCell id="c15" value='&lt;b&gt;WAF + API Gateway&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;[Envoy / Kong]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;TLS 1.3, JWT, rate limit, схемы, маскирование по тегам&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=8;strokeColor=#e8a202;strokeWidth=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1470" y="280" width="230" height="80" as="geometry"/></mxCell><mxCell id="c16" value='&lt;b&gt;Partner API Gateway&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;[Envoy / Kong]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;mTLS + OAuth2 scopes, JWS, анти-BOLA&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=8;strokeColor=#0E7DAD;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1720" y="280" width="230" height="80" as="geometry"/></mxCell><mxCell id="c17" value="Доменные сервисы (Java / Spring Boot, Kubernetes, mTLS service mesh)" style="rounded=1;fontSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;arcSize=2;fillColor=#eef5fc;strokeColor=#0D5091;fontColor=#0D5091;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="200" y="420" width="2020" height="440" as="geometry"/></mxCell><mxCell id="c18" value='&lt;b&gt;Notification&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;[Java]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;SMS / email (MVP), push, voice&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=8;strokeColor=#e8a202;strokeWidth=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="220" y="470" width="230" height="80" as="geometry"/></mxCell><mxCell id="c19" value='&lt;b&gt;Patient Registry (MPI)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;[Java]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;идентичность, токенизация&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=8;strokeColor=#e8a202;strokeWidth=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="470" y="470" width="230" height="80" as="geometry"/></mxCell><mxCell id="c20" value='&lt;b&gt;Scheduling&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;[Java]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;слоты, записи, филиалы&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=8;strokeColor=#e8a202;strokeWidth=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="720" y="470" width="230" height="80" as="geometry"/></mxCell><mxCell id="c21" value='&lt;b&gt;EHR (медкарта)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;[Java]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;записи врача, заключения, УКЭП&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=8;strokeColor=#0E7DAD;fontSize=10;" vertex="1" parent="1"><mxGeometry x="970" y="470" width="230" height="80" as="geometry"/></mxCell><mxCell id="c22" value='&lt;b&gt;CRM&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;[Java]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;коммуникации только по согласию&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=8;strokeColor=#0E7DAD;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1220" y="470" width="230" height="80" as="geometry"/></mxCell><mxCell id="c23" value='&lt;b&gt;Lab Integration&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;[Java]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;псевдонимизация заказов, FHIR&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=8;strokeColor=#0E7DAD;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1720" y="470" width="230" height="80" as="geometry"/></mxCell><mxCell id="c24" value='&lt;b&gt;Billing + Payment&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;[Java]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;счета, ПСП, фискализация&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=8;strokeColor=#0E7DAD;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1970" y="470" width="230" height="80" as="geometry"/></mxCell><mxCell id="c25" value='&lt;b&gt;MPI DB&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;[Postgres]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;pii.* field-level&lt;/span&gt;' style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#23A2D9;fontColor=#ffffff;strokeColor=#e8a202;strokeWidth=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="500" y="600" width="170" height="70" as="geometry"/></mxCell><mxCell id="c26" value='&lt;b&gt;Scheduling DB&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;[Postgres]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;patient_token, RLS&lt;/span&gt;' style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#23A2D9;fontColor=#ffffff;strokeColor=#e8a202;strokeWidth=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="750" y="600" width="170" height="70" as="geometry"/></mxCell><mxCell id="c27" value='&lt;b&gt;EHR DB&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;[Postgres]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;phi.*, DEK на пациента&lt;/span&gt;' style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#23A2D9;fontColor=#ffffff;strokeColor=#0E7DAD;fontSize=10;" vertex="1" parent="1"><mxGeometry x="970" y="600" width="110" height="70" as="geometry"/></mxCell><mxCell id="c28" value='&lt;b&gt;Documents&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;[MinIO S3]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;SSE-KMS, WORM&lt;/span&gt;' style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#23A2D9;fontColor=#ffffff;strokeColor=#0E7DAD;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1090" y="600" width="110" height="70" as="geometry"/></mxCell><mxCell id="c29" value='&lt;b&gt;CRM DB&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;[Postgres]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;consented only&lt;/span&gt;' style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#23A2D9;fontColor=#ffffff;strokeColor=#0E7DAD;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1250" y="600" width="170" height="70" as="geometry"/></mxCell><mxCell id="c30" value='&lt;b&gt;Token store&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;[Vault]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;order_id ↔ patient_id&lt;/span&gt;' style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#8e5cc2;fontColor=#ffffff;strokeColor=#6a3d9a;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1750" y="600" width="170" height="70" as="geometry"/></mxCell><mxCell id="c31" value='&lt;b&gt;Payments DB&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;[Postgres]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;fin.*&lt;/span&gt;' style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#23A2D9;fontColor=#ffffff;strokeColor=#0E7DAD;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1980" y="600" width="150" height="70" as="geometry"/></mxCell><mxCell id="c32" value='&lt;b&gt;Event Bus&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;[Kafka + Schema Registry]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;схемы событий с тегами полей · TLS + ACL по топикам · audit.*, reminder.due, consent.revoked, privacy.erase&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=8;strokeColor=#e8a202;strokeWidth=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="220" y="740" width="1730" height="90" as="geometry"/></mxCell><mxCell id="c33" value='&lt;b&gt;1С Integration Adapter&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;[Java]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;HTTP-сервисы 1С, без медданных&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=8;strokeColor=#0E7DAD;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1970" y="745" width="230" height="80" as="geometry"/></mxCell><mxCell id="c34" value="Privacy &amp; Security Platform — Privacy by Design (сквозные сервисы для всех контейнеров)" style="rounded=1;fontSize=12;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;arcSize=2;fillColor=#f3ecfa;strokeColor=#6a3d9a;fontColor=#4b2a70;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="200" y="900" width="2020" height="300" as="geometry"/></mxCell><mxCell id="c35" value='&lt;b&gt;IAM: Keycloak&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;[realm patients / staff]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;OIDC, OTP / ЕСИА, MFA, федерация с AD&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8e5cc2;fontColor=#ffffff;align=center;arcSize=8;strokeColor=#e8a202;strokeWidth=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="220" y="945" width="230" height="80" as="geometry"/></mxCell><mxCell id="c36" value='&lt;b&gt;Audit Log Service&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;[Java → ClickHouse (WORM)]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;кто, что, когда, зачем&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8e5cc2;fontColor=#ffffff;align=center;arcSize=8;strokeColor=#e8a202;strokeWidth=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="470" y="945" width="230" height="80" as="geometry"/></mxCell><mxCell id="c37" value='&lt;b&gt;Consent Service&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;[Java + Postgres]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;цель, объём, срок, версия; отзыв → событие&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8e5cc2;fontColor=#ffffff;align=center;arcSize=8;strokeColor=#e8a202;strokeWidth=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="720" y="945" width="230" height="80" as="geometry"/></mxCell><mxCell id="c38" value='&lt;b&gt;Privacy Requests &amp; Retention&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;[Java]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;доступ / удаление, TTL по тегам, crypto-shredding&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8e5cc2;fontColor=#ffffff;align=center;arcSize=8;strokeColor=#6a3d9a;fontSize=10;" vertex="1" parent="1"><mxGeometry x="970" y="945" width="230" height="80" as="geometry"/></mxCell><mxCell id="c39" value='&lt;b&gt;Data Catalog&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;[OpenMetadata]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;классификация, теги, Lineage&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8e5cc2;fontColor=#ffffff;align=center;arcSize=8;strokeColor=#6a3d9a;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1220" y="945" width="230" height="80" as="geometry"/></mxCell><mxCell id="c40" value='&lt;b&gt;Privacy Gate (CI/CD)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;[Conftest, Spectral, Semgrep]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;проверка тегов в релизе&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8e5cc2;fontColor=#ffffff;align=center;arcSize=8;strokeColor=#6a3d9a;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1470" y="945" width="230" height="80" as="geometry"/></mxCell><mxCell id="c41" value='&lt;b&gt;SIEM + UEBA&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;[Wazuh / MaxPatrol SIEM]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;корреляция, нетипичные действия&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8e5cc2;fontColor=#ffffff;align=center;arcSize=8;strokeColor=#6a3d9a;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1720" y="945" width="230" height="80" as="geometry"/></mxCell><mxCell id="c42" value='&lt;b&gt;Policy Engine: OPA&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;[Rego, policy-as-code]&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:9px"&gt;RBAC + ABAC: филиал, лечащий врач, patient = sub&lt;/span&gt;' style="rounded=1;w