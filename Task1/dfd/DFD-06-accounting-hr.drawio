<mxfile host="drawio" type="device"><diagram id="DFD-06-ToBe" name="DFD-06-ToBe"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="DFD-06 To-Be. Кадровый учёт, зарплата, отчётность" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="10" y="0" width="1600" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Кадры выделены в отдельную ИБ (1С:ЗУП) с ролевыми правами; обмен с банком и ФНС — без выгрузки файлов на ПК." style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="10" y="32" width="1600" height="30" as="geometry"/></mxCell><mxCell id="c4" value="Защищённый контур ИСПДн (облако / ЦОД в РФ, аттестован под УЗ-2): K8s, сегментация, mTLS, шифрование at rest, централизованный аудит" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#82b366;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=8;fontColor=#4d7a3a;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200" y="70" width="1190" height="690" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Нотация&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="775" width="250" height="20" as="geometry"/></mxCell><mxCell id="c6" value="Внешняя сущность / роль" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="797" width="150" height="30" as="geometry"/></mxCell><mxCell id="c7" value="Процесс / сервис" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="180" y="797" width="120" height="3