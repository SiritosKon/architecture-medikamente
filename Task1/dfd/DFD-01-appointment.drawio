<mxfile host="drawio" type="device"><diagram id="DFD-01-ToBe" name="DFD-01-ToBe"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="DFD-01 To-Be. Запись на приём через портал / мобильное приложение и напоминание (MVP)" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="10" y="0" width="1850" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Пациент записывается сам; ресепшен видит записи своего филиала в маскированном виде; напоминание за день без раскрытия специализации." style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="10" y="32" width="1850" height="30" as="geometry"/></mxCell><mxCell id="c4" value="Защищённый контур ИСПДн (облако / ЦОД в РФ, аттестован под УЗ-2): K8s, сегментация, mTLS, шифрование at rest, централизованный аудит" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#82b366;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=8;fontColor=#4d7a3a;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200" y="70" width="1420" height="790" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Нотация&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="875" width="250" height="20" as="geometry"/></mxCell><mxCell id="c6" value="Внешняя сущность / роль" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="897" width="150" height="30" as="geometry"/></mxCell><mxCell id="c7" value="Процесс / сервис" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="180" y="897" width="120" height="30" as="geometry"/></mxCell><mxCell id="c8" value="D#′ Хранилище + теги" style="shape=partialRectangle;whiteSpace=wrap;html=1;left=0;right=0;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="310" y="897" width="150" height="30" as="geometry"/></mxCell><mxCell id="c9" value="🔒 мера защиты" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#3d1f5c;fontSize=10;align=left;spacingLeft=4;arcSize=12;" vertex="1" parent="1"><mxGeometry x="470" y="897" width="130" height="30" as="geometry"/></mxCell><mxCell id="c10" value='&lt;font color="#6a3d9a"&gt;&lt;b&gt;—→&lt;/b&gt;&lt;/font&gt; поток с мерами защиты &amp;nbsp;&amp;nbsp; &lt;font color="#6a3d9a"&gt;&lt;b&gt;- - →&lt;/b&gt;&lt;/font&gt; событие аудита в DA (все обращения к данным журналируются)' style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="610" y="903" width="600" height="20" as="geometry"/></mxCell><mxCell id="c11" value="Пациент" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="300" width="150" height="60" as="geometry"/></mxCell><mxCell id="c12" value="Ресепшен" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="580" width="150" height="60" as="geometry"/></mxCell><mxCell id="c13" value="Медицинский&lt;br&gt;специалист" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1660" y="330" width="150" height="60" as="geometry"/></mxCell><mxCell id="c14" value="SMS / Push /&lt;br&gt;голосовой робот&lt;br&gt;(по поручению)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1660" y="570" width="170" height="80" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;1.1&lt;/b&gt;&lt;br&gt;Портал / мобильное&lt;br&gt;приложение (ЛК)" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="290" width="190" height="70" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;1.6&lt;/b&gt;&lt;br&gt;Портал ресепшена" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="570" width="190" height="70" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;1.2&lt;/b&gt;&lt;br&gt;API Gateway + IAM&lt;br&gt;(Keycloak, OPA)" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="430" width="190" height="70" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;1.3&lt;/b&gt;&lt;br&gt;Scheduling Service" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="330" width="190" height="70" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;1.4&lt;/b&gt;&lt;br&gt;Patient Registry (MPI)" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="110" width="190" height="70" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;1.5&lt;/b&gt;&lt;br&gt;Notification Service" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="580" width="190" height="70" as="geometry"/></mxCell><mxCell id="c21" value='&lt;b&gt;D1′&lt;/b&gt; | Расписание и записи (Postgres)&lt;br&gt;&lt;i&gt;&lt;font style="font-size:9px" color="#7a5c00"&gt;tags: internal, pii.pseudo — patient_token вместо ФИО&lt;/font&gt;&lt;/i&gt;' style="shape=partialRectangle;whiteSpace=wrap;html=1;left=0;right=0;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1310" y="340" width="260" height="56" as="geometry"/></mxCell><mxCell id="c22" value='&lt;b&gt;D2′&lt;/b&gt; | Реестр пациентов (Postgres)&lt;br&gt;&lt;i&gt;&lt;font style="font-size:9px" color="#7a5c00"&gt;tags: pii.contact [C3], phone/email зашифрованы&lt;/font&gt;&lt;/i&gt;' style="shape=partialRectangle;whiteSpace=wrap;html=1;left=0;right=0;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1310" y="120" width="260" height="56" as="geometry"/></mxCell><mxCell id="c23" value="1. Вход: телефон + OTP / ЕСИА;&lt;br&gt;выбор врача и слота [TLS 1.3]" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;rounded=0;exitX=1;exitY=0.24999999999999997;exitDx=0;exitDy=0;entryX=0;entryY=0.24999999999999997;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="2. Подтверждение" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;rounded=0;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="c15" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="3. Запрос + access token&lt;br&gt;(OIDC + PKCE)" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="c15" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="4. patient_id из токена&lt;br&gt;(не из запроса), врач, слот [mTLS]" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="5. patient_token,&lt;br&gt;doctor_id, slot" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.24999999999999997;exitDx=0;exitDy=0;entryX=0;entryY=0.24999999999999997;entryDx=0;entryDy=0;" edge="1" parent="1" source="c18" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="6. Свободные слоты" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="c21" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="7. Проверка пациента" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.24999999999999997;exitY=0;exitDx=0;exitDy=0;entryX=0.24999999999999997;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c18" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="8. Статус, согласия" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c19" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="9. Шифрование полей&lt;br&gt;(Vault Transit)" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.24999999999999997;exitDx=0;exitDy=0;entryX=0;entryY=0.24999999999999997;entryDx=0;entryDy=0;" edge="1" parent="1" source="c19" target="c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="ФИО, контакты" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="c22" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="10. Расписание филиала&lt;br&gt;[RBAC reception + ABAC branch_id]" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.24999999999999997;exitDx=0;exitDy=0;entryX=0;entryY=0.24999999999999997;entryDx=0;entryDy=0;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c34" value="11. Маскировано: «Иванов И.»,&lt;br&gt;+7 *** ***-**-12" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="c17" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c35" value="SSO + MFA" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c12" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c36" value="12. reminder.due: patient_token,&lt;br&gt;время, филиал (Kafka, TLS)" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c18" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c37" value="13. Детокенизация контакта&lt;br&gt;(только роль notifier)" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=1;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="c20" target="c19"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1230" y="594"/><mxPoint x="1230" y="166"/></Array></mxGeometry></mxCell><mxCell id="c38" value="14. «Запись 12.10 10:00, филиал №2»&lt;br&gt;— без врача и специализации" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.24999999999999997;exitDx=0;exitDy=0;entryX=0;entryY=0.24999999999999997;entryDx=0;entryDy=0;" edge="1" parent="1" source="c20" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c39" value="15. Подтвердить / отменить" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="c14" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c40" value="16. Только свои пациенты на день (АРМ врача, ABAC doctor_id)" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.8;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c18" target="c13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1112" y="270"/><mxPoint x="1735" y="270"/></Array></mxGeometry></mxCell><mxCell id="c41" value='&lt;b&gt;DA&lt;/b&gt; | Журнал аудита (append-only)&lt;br&gt;&lt;i&gt;&lt;font style="font-size:9px" color="#7a5c00"&gt;ClickHouse, WORM, → SIEM / UEBA&lt;/font&gt;&lt;/i&gt;' style="shape=partialRectangle;whiteSpace=wrap;html=1;left=0;right=0;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="620" y="760" width="230" height="56" as="geometry"/></mxCell><mxCell id="c42" value