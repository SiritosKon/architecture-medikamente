r=#9673a6;dashed=1;dashPattern=2 2;" edge="1" parent="1" source="c48" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c50" value="🔒 Проверка согласия на уведомления (Consent); договор поручения с провайдером" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#3d1f5c;fontSize=10;align=left;spacingLeft=4;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1310" y="700" width="280" height="60" as="geometry"/></mxCell><mxCell id="c51" value="" style="html=1;endArrow=none;strokeColor=#9673a6;dashed=1;dashPattern=2 2;" edge="1" parent="1" source="c50" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c52" value="🔒 Маскирование в ответе API по тегу pii.contact (data contract)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#3d1f5c;fontSize=10;align=left;spacingLeft=4;arcSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="690" width="240" height="50" as="geometry"/></mxCell><mxCell id="c53" value="" style="html=1;endArrow=none;strokeColor=#9673a6;dashed=1;dashPattern=2 2;" edge="1" parent="1" source="c52" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>