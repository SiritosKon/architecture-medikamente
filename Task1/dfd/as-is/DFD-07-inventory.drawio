<mxfile host="drawio" type="device"><diagram id="DFD-07" name="DFD-07"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="DFD-07. Складской учёт ТМЦ и закупки (As-Is)" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="10" y="0" width="1580" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Склад (3 чел.) в файловой 1С:Торговля и склад, интегрированной с 1С:БП. ПДн минимальны, но встречается списание на конкретного пациента." style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="10" y="32" width="1580" height="30" as="geometry"/></mxCell><mxCell id="c4" value="Граница доверия: ИС офиса (ЛВС, общий диск, 1С, Exchange) — единый домен AD, без сегментации и аудита" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#b85450;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=8;fontColor=#b85450;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200" y="70" width="1170" height="650" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Нотация (Gane–Sarson)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="735" width="250" height="20" as="geometry"/></mxCell><mxCell id="c6" value="Внешняя сущность / роль" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="757" width="150" height="30" as="geometry"/></mxCell><mxCell id="c7" value="Процесс" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="180" y="757" width="120" height="30" as="geomet