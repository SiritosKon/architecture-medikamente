<mxfile host="drawio" type="device"><diagram id="DFD-08-ToBe" name="DFD-08-ToBe"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="DFD-08 To-Be. Аналитика, BI, ML и LLM на обезличенных данных (Privacy-preserving Data Platform)" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="10" y="0" width="1600" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Данные попадают в озеро только через конвейер обезличивания, управляемый тегами каталога данных. Прямой ПДн в аналитике нет; Lineage фиксируется автоматически." style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="10" y="32" width="1600" height="30" as="geometry"/></mxCell><mxCell id="c4" value="Защищённый контур ИСПДн (облако / ЦОД в РФ, аттестован под УЗ-2): K8s, сегментация, mTLS, шифрование at rest, централизованный аудит" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#82b366;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=8;fontColor=#4d7a3a;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200" y="70" width="1400" height="790" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Нотация&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="875" width="250" height="20" as="geometry"/></mxCell><mxCell id="c6" value="Внешняя сущность / роль" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="897" width="150" height="30" as="geometry"/></mxCell><mxCell id="c7" value="Процесс / сервис" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="180" y="897" width="120" height="30" as="geometry"/></mxCell><mxCell id="c8" value="D#′ Хранилище + теги" style="shape=partialRectangle;whiteSpace=wrap;html=1;left=0;right=0;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="310" y="897" width="150" height="30" as="geometry"/></mxCell><mxCell id="c9" value="🔒 мера защиты" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#3d1f5c;fontSize=10;align=left;spacingLeft=4;arcSize=12;" vertex="1" parent="1"><mxGeometry x="470" y="897" width="130" height="30" as="geometry"/></mxCell><mxCell id="c10" value='&lt;font color="#6a3d9a"&gt;&lt;b&gt;—→&lt;/b&gt;&lt;/font&gt; поток с мерами защиты &amp;nbsp;&amp;nbsp; &lt;font color="#6a3d9a"&gt;&lt;b&gt;- - →&lt;/b&gt;&lt;/font&gt; событие аудита в DA (все обращения к данным журналируются)' style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="610" y="903" width="600" height="20" as="geometry"/></mxCell><mxCell id="c11" value="Аналитик /&lt;br&gt;Data Scientist" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="560" width="150" height="60" as="geometry"/></mxCell><mxCell id="c12" value="Руководство /&lt;br&gt;филиалы" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="760" width="150" height="60" as="geometry"/></mxCell><mxCell id="c13" value='&lt;b&gt;D1′…D7′&lt;/b&gt; | Операционные БД сервисов&lt;br&gt;&lt;i&gt;&lt;font style="font-size:9px" color="#7a5c00"&gt;теги из Data Catalog&lt;/font&gt;&lt;/i&gt;' style="shape=partialRectangle;whiteSpace=wrap;html=1;left=0;right=0;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="250" y="110" width="230" height="56" as="geometry"/></mxCell><mxCell id="c14" value='&lt;b&gt;D-XLS&lt;/b&gt; | Архив Excel / сканов (миграция)&lt;br&gt;&lt;i&gt;&lt;font style="font-size:9px" color="#7a5c00"&gt;до обработки — restricted&lt;/font&gt;&lt;/i&gt;' style="shape=partialRectangle;whiteSpace=wrap;html=1;left=0;right=0;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="250" y="250" width="230" height="56" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;8.1&lt;/b&gt;&lt;br&gt;CDC (Debezium) → Kafka" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="580" y="110" width="190" height="70" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;8.6&lt;/b&gt;&lt;br&gt;Разовая загрузка Excel +&lt;br&gt;PII-сканер" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="580" y="240" width="190" height="70" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;8.2&lt;/b&gt;&lt;br&gt;Privacy Pipeline:&lt;br&gt;псевдонимизация, обобщение,&lt;br&gt;k-анонимность" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="160" width="220" height="90" as="geometry"/></mxCell><mxCell id="c18" value='&lt;b&gt;L0&lt;/b&gt; | Raw zone (restricted)&lt;br&gt;&lt;i&gt;&lt;font style="font-size:9px" color="#7a5c00"&gt;шифр., доступ только pipeline, TTL 14 дней&lt;/font&gt;&lt;/i&gt;' style="shape=partialRectangle;whiteSpace=wrap;html=1;left=0;right=0;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1260" y="110" width="240" height="56" as="geometry"/></mxCell><mxCell id="c19" value='&lt;b&gt;L1&lt;/b&gt; | Curated: pseudonymized lake&lt;br&gt;&lt;i&gt;&lt;font style="font-size:9px" color="#7a5c00"&gt;S3 + Iceberg, pii.pseudo&lt;/font&gt;&lt;/i&gt;' style="shape=partialRectangle;whiteSpace=wrap;html=1;left=0;right=0;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="900" y="380" width="240" height="56" as="geometry"/></mxCell><mxCell id="c20" value='&lt;b&gt;L2&lt;/b&gt; | Витрины ClickHouse&lt;br&gt;&lt;i&gt;&lt;font style="font-size:9px" color="#7a5c00"&gt;агрегаты, k ≥ 5, RLS по филиалу&lt;/font&gt;&lt;/i&gt;' style="shape=partialRectangle;whiteSpace=wrap;html=1;left=0;right=0;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="900" y="560" width="240" height="56" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;8.3&lt;/b&gt;&lt;br&gt;BI (Superset / DataLens)" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="580" y="560" width="190" height="70" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;8.4&lt;/b&gt;&lt;br&gt;ML / LLM sandbox&lt;br&gt;(JupyterHub, on-prem LLM)" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="580" y="380" width="210" height="70" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;8.5&lt;/b&gt;&lt;br&gt;Data Catalog + Lineage&lt;br&gt;(OpenMetadata)" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1260" y="380" width="220" height="70" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;8.7&lt;/b&gt;&lt;br&gt;Ре-идентификация&lt;br&gt;(по заявке, одобряет DPO)" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1260" y="560" width="220" height="70" as="geometry"/></mxCell><mxCell id="c25" value="1. Изменения (WAL)" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c13" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="2. Файлы" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c14" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="3. События с тегами" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c15" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="4. Записи + найденные ПДн" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="5. Только при необходимости" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="6. patient_key = HMAC(id, key из Vault);&lt;br&gt;ДР → возраст, адрес → город;&lt;br&gt;free text → NER-редакция" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c17" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="7. Агрегация" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c19" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="8. Метрики, P&amp;L, ABC" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c20" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="9. Обучающие выборки" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c19" target="c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c34" value="10. Дашборды (RBAC)" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c21" target="c12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="675" y="790"/></Array></mxGeometry></mxCell><mxCell id="c35" value="11. SSO" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c11" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c36" value="12. SSO + MFA" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c37" value="13. Политики по тегам" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.3;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="c23" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c38" value="14. Lineage" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;dashed=1;fontSize=10;fontColor=#4b2a70;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.1;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c17" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c39" value="15. Точечно, с журналом" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;dashed=1;fontSize=10;fontColor=#4b2a70;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c24" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c40" value="🔒 Запрет выгрузки сырых данных из sandbox; модели проверяются на утечку ПДн (membership inference)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#3d1f5c;fontSize=10;align=left;spacingLeft=4;arcSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="440" width="290" height="60" as="geometry"/></mxCell><mxCell id="c41" value="" style="html=1;endArrow=none;strokeColor=#9673a6;dashed=1;dashPattern=2 2;" edge="1" parent="1" source="c40" target="c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c42" value="🔒 LLM: только on-prem / в РФ; промпты и ответы — через PII-фильтр; RAG по обезличенным текстам" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#3d1f5c;fontSize=10;align=left;spacingLeft=4;arcSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="660" width="290" height="60" as="geometry"/></mxCell><mxCell id="c43" value="" style="html=1;endArrow=none;strokeColor=#9673a6;dashed=1;dashPattern=2 2;" edge="1" parent="1" source="c42" target="c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c44" value="🔒 Цель обработки фиксируется в каталоге (152-ФЗ ст.5 ч.2); обезличенные данные ≠ ПДн при соблюдении требований РКН" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#3d1f5c;fontSize=10;align=left;spacingLeft=4;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1150" y="680" width="320" height="60" as="geometry"/></mxCell><mxCell id="c45" value="" style="html=1;endArrow=none;strokeColor=#9673a6;dashed=1;dashPattern=2 2;" edge="1" parent="1" source="c44" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>