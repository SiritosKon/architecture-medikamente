<mxfile host="drawio" type="device"><diagram id="DFD-03-ToBe" name="DFD-03-ToBe"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="DFD-03 To-Be. Приём у специалиста и электронная медицинская карта (EHR)" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="10" y="0" width="1600" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Доступ к карте — только у лечащего врача (ABAC); записи версионируются и подписываются УКЭП; пациент видит заключение только в своём ЛК." style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="10" y="32" width="1600" height="30" as="geometry"/></mxCell><mxCell id="c4" value="Защищённый контур ИСПДн (облако / ЦОД в РФ, аттестован под УЗ-2): K8s, сегментация, mTLS, шифрование at rest, централизованный аудит" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#82b366;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=8;fontColor=#4d7a3a;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200" y="70" width="1400" height="750" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Нотация&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="835" width="250" height="20" as="geometry"/></mxCell><mxCell id="c6" value="Внешняя сущность / роль" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="857" width="150" height="30" as="geometry"/></mxCell><mxCell id="c7" value="Процесс / сервис" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="180" y="857" width="120" height="30" as="geometry"/></mxCell><mxCell id="c8" value="D#′ Хранилище + теги" style="shape=partialRectangle;whiteSpace=wrap;html=1;left=0;right=0;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="310" y="857" width="150" height="30" as="geometry"/></mxCell><mxCell id="c9" value="🔒 мера защиты" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#3d1f5c;fontSize=10;align=left;spacingLeft=4;arcSize=12;" vertex="1" parent="1"><mxGeometry x="470" y="857" width="130" height="30" as="geometry"/></mxCell><mxCell id="c10" value='&lt;font color="#6a3d9a"&gt;&lt;b&gt;—→&lt;/b&gt;&lt;/font&gt; поток с мерами защиты &amp;nbsp;&amp;nbsp; &lt;font color="#6a3d9a"&gt;&lt;b&gt;- - →&lt;/b&gt;&lt;/font&gt; событие аудита в DA (все обращения к данным журналируются)' style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="610" y="863" width="600" height="20" as="geometry"/></mxCell><mxCell id="c11" value="Пациент" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="330" width="150" height="60" as="geometry"/></mxCell><mxCell id="c12" value="Медицинский&lt;br&gt;специалист" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="110" width="150" height="60" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;3.1&lt;/b&gt;&lt;br&gt;АРМ врача (EHR UI)&lt;br&gt;SSO + MFA" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="100" width="190" height="70" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;3.2&lt;/b&gt;&lt;br&gt;Policy Decision (OPA)&lt;br&gt;«лечащий врач?»" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="100" width="190" height="70" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;3.3&lt;/b&gt;&lt;br&gt;EHR Service" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="330" width="190" height="70" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;3.4&lt;/b&gt;&lt;br&gt;Публикация&lt;br&gt;заключения в ЛК" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="540" width="190" height="70" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;3.5&lt;/b&gt;&lt;br&gt;Портал / моб. приложение" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="620" width="190" height="70" as="geometry"/></mxCell><mxCell id="c18" value='&lt;b&gt;D4′&lt;/b&gt; | Медкарты (Postgres)&lt;br&gt;&lt;i&gt;&lt;font style="font-size:9px" color="#7a5c00"&gt;phi.diagnosis, phi.anamnesis [C4]&lt;/font&gt;&lt;/i&gt;' style="shape=partialRectangle;whiteSpace=wrap;html=1;left=0;right=0;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1010" y="250" width="230" height="56" as="geometry"/></mxCell><mxCell id="c19" value='&lt;b&gt;D6′&lt;/b&gt; | Результаты анализов&lt;br&gt;&lt;i&gt;&lt;font style="font-size:9px" color="#7a5c00"&gt;phi.lab [C4]&lt;/font&gt;&lt;/i&gt;' style="shape=partialRectangle;whiteSpace=wrap;html=1;left=0;right=0;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1010" y="400" width="230" height="56" as="geometry"/></mxCell><mxCell id="c20" value='&lt;b&gt;D11′&lt;/b&gt; | Сканы архивных карт (S3)&lt;br&gt;&lt;i&gt;&lt;font style="font-size:9px" color="#7a5c00"&gt;phi.scan [C4], SSE-KMS&lt;/font&gt;&lt;/i&gt;' style="shape=partialRectangle;whiteSpace=wrap;html=1;left=0;right=0;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1010" y="530" width="230" height="56" as="geometry"/></mxCell><mxCell id="c21" value="1. Вход (Keycloak ↔ AD)" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="2. Запрос карты patient_id" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="3. Permit: активный эпизод&lt;br&gt;/ запись к этому врачу" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="4. Версионная запись&lt;br&gt;(append-only) + УКЭП" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.24999999999999997;exitDx=0;exitDy=0;entryX=0;entryY=0.24999999999999997;entryDx=0;entryDy=0;" edge="1" parent="1" source="c15" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="5. Карта пациента" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="c18" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="6. Результаты" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c19" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="7. Архив" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c20" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="8. Жалобы, анамнез (со слов)" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.24999999999999997;exitDx=0;exitDy=0;entryX=0;entryY=0.24999999999999997;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="9. Рекомендации" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="c15" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="10. Заключение (PDF, подписано)" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="697" y="575"/></Array></mxGeometry></mxCell><mxCell id="c31" value="11. Документ в ЛК" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="560" y="596"/><mxPoint x="560" y="655"/></Array></mxGeometry></mxCell><mxCell id="c32" value="12. Push «документ готов» без диагноза;&lt;br&gt;просмотр после входа (ABAC: patient_id = sub)" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c17" target="c11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="95" y="655"/></Array></mxGeometry></mxCell><mxCell id="c33" value='&lt;b&gt;DA&lt;/b&gt; | Журнал аудита (append-only)&lt;br&gt;&lt;i&gt;&lt;font style="font-size:9px" color="#7a5c00"&gt;ClickHouse, WORM, → SIEM / UEBA&lt;/font&gt;&lt;/i&gt;' style="shape=partialRectangle;whiteSpace=wrap;html=1;left=0;right=0;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1010" y="110" width="230" height="56" as="geometry"/></mxCell><mxCell id="c34" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;dashed=1;fontSize=10;fontColor=#4b2a70;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c14" target="c33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c35" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;dashed=1;fontSize=10;fontColor=#4b2a70;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c15" target="c33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c36" value="🔒 Break-glass: экстренный доступ с обоснованием → алерт DPO и SIEM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#3d1f5c;fontSize=10;align=left;spacingLeft=4;arcSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="210" width="260" height="50" as="geometry"/></mxCell><mxCell id="c37" value="" style="html=1;endArrow=none;strokeColor=#9673a6;dashed=1;dashPattern=2 2;" edge="1" parent="1" source="c36" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c38" value="🔒 DLP на АРМ: запрет USB, контроль печати (watermark с ФИО врача), блок. копирования в личную почту" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#3d1f5c;fontSize=10;align=left;spacingLeft=4;arcSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="200" width="260" height="70" as="geometry"/></mxCell><mxCell id="c39" value="" style="html=1;endArrow=none;strokeColor=#9673a6;dashed=1;dashPattern=2 2;" edge="1" parent="1" source="c38" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c40" value="🔒 Field-level шифрование диагноза; pgaudit; ключи в Vault; теги из Data Catalog" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#3d1f5c;fontSize=10;align=left;spacingLeft=4;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1260" y="330" width="220" height="70" as="geometry"/></mxCell><mxCell id="c41" value="" style="html=1;endArrow=none;strokeColor=#9673a6;dashed=1;dashPattern=2 2;" edge="1" parent="1" source="c40" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c42" value="🔒 Защита от BOLA/IDOR: ID из токена, проверка владельца объекта" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#3d1f5c;fontSize=10;align=left;spacingLeft=4;arcSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="640" width="250" height="50" as="geometry"/></mxCell><mxCell id="c43" value="" style="html=1;endArrow=none;strokeColor=#9673a6;dashed=1;dashPattern=2 2;" edge="1" parent="1" source="c42" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>