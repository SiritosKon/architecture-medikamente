0;labelBackgroundColor=#ffffff;exitX=0.7;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="433" y="155"/></Array></mxGeometry></mxCell><mxCell id="c26" value="4. Факт, время, версия" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c14" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="5. Идентификационные ПДн" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="c13" target="c16"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="580" y="346"/><mxPoint x="580" y="461"/></Array></mxGeometry></mxCell><mxCell id="c28" value="6. Шифрование полей, дедупликация" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c16" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="7. Сверка паспорта при визите:&lt;br&gt;флаг verified, скан не хранится" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="c12" target="c16"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="620" y="710"/><mxPoint x="620" y="496"/></Array></mxGeometry></mxCell><mxCell id="c30" value="8. Расширенная анкета (хрон. заболевания) —&lt;br&gt;только по назначению врача, сразу в EHR" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="1" source="c13" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="9. phi" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c17" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="10. Данные&lt;br&gt;для договора" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.1;exitY=1;exitDx=0;exitDy=0;entryX=0.1;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c13" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="11. Подписанный&lt;br&gt;договор" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.9;exitY=0;exitDx=0;exitDy=0;entryX=0.9;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c18" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c34" value="12. PDF + ПЭП" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c18" target="c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c35" value="13. Отзыв согласия / запрос на удаление или выгрузку (152-ФЗ ст.14, 21)" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c15"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="95" y="103"/><mxPoint x="1210" y="103"/></Array></mxGeometry></mxCell><mxCell id="c36" value="14. Отзыв" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c15" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c37" value="15. privacy.erase / stop" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c38" value="16. stop-processing&lt;br&gt;(медданные — хранение по 323-ФЗ)" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c15" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c39" value='&lt;b&gt;DA&lt;/b&gt; | Журнал аудита (append-only)&lt;br&gt;&lt;i&gt;&lt;font style="font-size:9px" color="#7a5c00"&gt;ClickHouse, WORM, → SIEM / UEBA&lt;/font&gt;&lt;/i&gt;' style="shape=partialRectangle;whiteSpace=wrap;html=1;left=0;right=0;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1450" y="130" width="240" height="56" as="geometry"/></mxCell><mxCell id="c40" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;dashed=1;fontSize=10;fontColor=#4b2a70;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c14" target="c39"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c41" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;dashed=1;fontSize=10;fontColor=#4b2a70;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c15" target="c39"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c42" value="🔒 Data Minimization: паспорт, адрес, работа — только если нужны для договора / ДМС" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#3d1f5c;fontSize=10;align=left;spacingLeft=4;arcSize=12;" vertex="1" parent="1"><m