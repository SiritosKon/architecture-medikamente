<mxfile host="drawio" type="device"><diagram id="DFD-02-ToBe" name="DFD-02-ToBe"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="DFD-02 To-Be. Регистрация, договор и управление согласиями (Consent Management)" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="10" y="0" width="1850" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Минимальная анкета при регистрации; медицинские сведения — сразу в EHR; согласия структурированы; отзыв согласия останавливает обработку во всех сервисах." style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="10" y="32" width="1850" height="30" as="geometry"/></mxCell><mxCell id="c4" value="Защищённый контур ИСПДн (облако / ЦОД в РФ, аттестован под УЗ-2): K8s, сегментация, mTLS, шифрование at rest, централизованный аудит" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#82b366;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=8;fontColor=#4d7a3a;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200" y="70" width="1650" height="790" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Нотация&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="875" width="250" height="20" as="geometry"/></mxCell><mxCell id="c6" value="Внешняя сущность / роль" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="897" width="150" height="30" as="geometry"/></mxCell><mxCell id="c7" value="Процесс / сервис" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="180" y="897" width="120" height="30" as="geometry"/></mxCell><mxCell id="c8" value="D#′ Хранилище + теги" style="shape=partialRectangle;whiteSpace=wrap;html=1;left=0;right=0;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="310" y="897" width="150" height="30" as="geometry"/></mxCell><mxCell id="c9" value="🔒 мера защиты" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#3d1f5c;fontSize=10;align=left;spacingLeft=4;arcSize=12;" vertex="1" parent="1"><mxGeometry x="470" y="897" width="130" height="30" as="geometry"/></mxCell><mxCell id="c10" value='&lt;font color="#6a3d9a"&gt;&lt;b&gt;—→&lt;/b&gt;&lt;/font&gt; поток с мерами защиты &amp;nbsp;&amp;nbsp; &lt;font color="#6a3d9a"&gt;&lt;b&gt;- - →&lt;/b&gt;&lt;/font&gt; событие аудита в DA (все обращения к данным журналируются)' style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="610" y="903" width="600" height="20" as="geometry"/></mxCell><mxCell id="c11" value="Пациент" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="300" width="150" height="60" as="geometry"/></mxCell><mxCell id="c12" value="Ресепшен" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="680" width="150" height="60" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;2.1&lt;/b&gt;&lt;br&gt;Регистрация в ЛК&lt;br&gt;(минимальный набор)" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="290" width="190" height="70" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;2.2&lt;/b&gt;&lt;br&gt;Consent Service&lt;br&gt;(согласия, цели, сроки)" style="rounded=1;arcSize=25