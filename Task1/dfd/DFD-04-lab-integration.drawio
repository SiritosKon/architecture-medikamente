<mxfile host="drawio" type="device"><diagram id="DFD-04-ToBe" name="DFD-04-ToBe"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="DFD-04 To-Be. Интеграция с лабораторией через API (Partner API Gateway)" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="10" y="0" width="1600" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Лаборатория получает псевдонимизированный заказ (order_id, пол, возраст, коды тестов) — без ФИО и диагноза. Результат сопоставляется с пациентом только внутри контура." style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="10" y="32" width="1600" height="30" as="geometry"/></mxCell><mxCell id="c4" value="Защищённый контур ИСПДн (облако / ЦОД в РФ, аттестован под УЗ-2): K8s, сегментация, mTLS, шифрование at rest, централизованный аудит" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#82b366;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=8;fontColor=#4d7a3a;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200" y="70" width="1190" height="750" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Нотация&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="835" width="250" height="20" as="geometry"/></mxCell><mxCell id="c6" value="Внешняя сущность / роль" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="857" width="150" height="30" as="geometry"/></mxCell><mxCell id="c7" value="Процесс / сервис" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="180" y="857" width="120" height="30" as="geometry"/></mxCell><mxCell id="c8" value="D#′ Хранилище + теги" style="shape=partialRectangle;whiteSpace=wrap;html=1;left=0;right=0;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="310" y="857" width="150" height="30" as="geometry"/></mxCell><mxCell id="c9" value="🔒 мера защиты" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#3d1f5c;fontSize=10;align=left;spacingLeft=4;arcSize=12;" vertex="1" parent="1"><mxGeometry x="470" y="857" width="130" height="30" as="geometry"/></mxCell><mxCell id="c10" value='&lt;font color="#6a3d9a"&gt;&lt;b&gt;—→&lt;/b&gt;&lt;/font&gt; поток с мерами защиты &amp;nbsp;&amp;nbsp; &lt;font color="#6a3d9a"&gt;&lt;b&gt;- - →&lt;/b&gt;&lt;/font&gt; событие аудита в DA (все обращения к данным журналируются)' style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="610" y="863" width="600" height="20" as="geometry"/></mxCell><mxCell id="c11" value="Медицинский&lt;br&gt;специалист" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="110" width="150" height="60" as="geometry"/></mxCell><mxCell id="c12" value="Пациент" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="700" width="150" height="60" as="geometry"/></mxCell><mxCell id="c13" value="Лаборатория&lt;br&gt;(партнёр, договор&lt;br&gt;поручения)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1430" y="300" width="160" height="70" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;4.1&lt;/b&gt;&lt;br&gt;Направление в EHR&lt;br&gt;(коды тестов)" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="100" width="190" height="70" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;4.2&lt;/b&gt;&lt;br&gt;Lab Integration Service&lt;br&gt;(псевдонимизация)" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="300" width="210" height="70" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;4.3&lt;/b&gt;&lt;br&gt;Partner API Gateway&lt;br&gt;(mTLS + OAuth2)" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="300" width="190" height="70" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;4.4&lt;/b&gt;&lt;br&gt;Приём результата,&lt;br&gt;ре-идентификация" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="540" width="210" height="70" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;4.5&lt;/b&gt;&lt;br&gt;ЛК пациента" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="690" width="190" height="70" as="geometry"/></mxCell><mxCell id="c19" value='&lt;b&gt;D12&lt;/b&gt; | Сопоставление order_id ↔ patient_id&lt;br&gt;&lt;i&gt;&lt;font style="font-size:9px" color="#7a5c00"&gt;Vault / token store, доступ только 4.2 и 4.4&lt;/font&gt;&lt;/i&gt;' style="shape=partialRectangle;whiteSpace=wrap;html=1;left=0;right=0;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="280" y="430" width="270" height="56" as="geometry"/></mxCell><mxCell id="c20" value='&lt;b&gt;D6′&lt;/b&gt; | Результаты анализов&lt;br&gt;&lt;i&gt;&lt;font style="font-size:9px" color="#7a5c00"&gt;phi.lab [C4], field-level шифрование&lt;/font&gt;&lt;/i&gt;' style="shape=partialRectangle;whiteSpace=wrap;html=1;left=0;right=0;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1000" y="560" width="230" height="56" as="geometry"/></mxCell><mxCell id="c21" value="1. Назначение" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c11" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="2. order: patient_id, тесты" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.7;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="433" y="335"/></Array></mxGeometry></mxCell><mxCell id="c23" value="3. Выпуск order_id" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.24999999999999997;exitDx=0;exitDy=0;entryX=1;entryY=0.24999999999999997;entryDx=0;entryDy=0;" edge="1" parent="1" source="c15" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="4. Токен" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="c19" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="5. {order_id, sex, age_band,&lt;br&gt;test_codes, sample_id}" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="6. Заказ (JWS-подпись)" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.24999999999999997;exitDx=0;exitDy=0;entryX=0;entryY=0.24999999999999997;entryDx=0;entryDy=0;" edge="1" parent="1" source="c16" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="7. Результат FHIR&lt;br&gt;DiagnosticReport" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="c13" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="8. Результат по order_id&lt;br&gt;(scope results:write)" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1095" y="480"/><mxPoint x="900" y="480"/><mxPoint x="900" y="575"/></Array></mxGeometry></mxCell><mxCell id="c29" value="9. order_id → patient_id" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="c17" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="10. Результат (шифр.)" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c17" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="11. Событие «результат готов»" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="12. Просмотр только своих&lt;br&gt;результатов (patient_id = sub)" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c18" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value='&lt;b&gt;DA&lt;/b&gt; | Журнал аудита (append-only)&lt;br&gt;&lt;i&gt;&lt;font style="font-size:9px" color="#7a5c00"&gt;ClickHouse, WORM, → SIEM / UEBA&lt;/font&gt;&lt;/i&gt;' style="shape=partialRectangle;whiteSpace=wrap;html=1;left=0;right=0;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1000" y="700" width="230" height="56" as="geometry"/></mxCell><mxCell id="c34" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;dashed=1;fontSize=10;fontColor=#4b2a70;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c16" target="c33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c35" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;dashed=1;fontSize=10;fontColor=#4b2a70;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c17" target="c33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c36" value="🔒 API-контракт: поля с x-data-classification; ответ фильтруется по scope партнёра; ПДн не в URL/логах" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#3d1f5c;fontSize=10;align=left;spacingLeft=4;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="130" width="260" height="70" as="geometry"/></mxCell><mxCell id="c37" value="" style="html=1;endArrow=none;strokeColor=#9673a6;dashed=1;dashPattern=2 2;" edge="1" parent="1" source="c36" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c38" value="🔒 Защита от BOLA: партнёр видит только свои order_id; rate limit; idempotency-key; схема валидируется" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#3d1f5c;fontSize=10;align=left;spacingLeft=4;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1230" y="420" width="300" height="60" as="geometry"/></mxCell><mxCell id="c39" value="" style="html=1;endArrow=none;strokeColor=#9673a6;dashed=1;dashPattern=2 2;" edge="1" parent="1" source="c38" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c40" value="🔒 Privacy by Default: новая интеграция наследует политику тегов — не нужно перепроверять" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#3d1f5c;fontSize=10;align=left;spacingLeft=4;arcSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="150" width="300" height="50" as="geometry"/></mxCell><mxCell id="c41" value="" style="html=1;endArrow=none;strokeColor=#9673a6;dashed=1;dashPattern=2 2;" edge="1" parent="1" source="c40" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>