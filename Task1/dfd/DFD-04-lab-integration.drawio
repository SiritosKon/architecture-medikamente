<mxfile host="drawio" type="device"><diagram id="DFD-04" name="DFD-04"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="DFD-04. Интеграция с лабораторией через API" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="10" y="0" width="1320" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Лаборатория получает заказ без ФИО и диагноза; результат сопоставляется с пациентом внутри контура." style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="10" y="32" width="1320" height="24" as="geometry"/></mxCell><mxCell id="c4" value="Защищённый контур (облако / ЦОД в РФ)" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#82b366;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=8;fontColor=#4d7a3a;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="70" width="830" height="440" as="geometry"/></mxCell><mxCell id="c5" value="Медицинский&lt;br&gt;специалист" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="115" width="150" height="60" as="geometry"/></mxCell><mxCell id="c6" value="Пациент" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="415" width="150" height="60" as="geometry"/></mxCell><mxCell id="c7" value="Лаборатория" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1130" y="265" width="180" height="60" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;4.1&lt;/b&gt;&lt;br&gt;Направление&lt;br&gt;на анализ" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="110" width="190" height="70" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;4.2&lt;/b&gt;&lt;br&gt;Псевдонимизация&lt;br&gt;заказа" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="570" y="110" width="190" height="70" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;4.3&lt;/b&gt;&lt;br&gt;Приём результата" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="570" y="410" width="190" height="70" as="geometry"/></mxCell><mxCell id="c11" value='&lt;b&gt;D6′&lt;/b&gt; | Результаты&lt;br&gt;&lt;i&gt;&lt;font style="font-size:9px" color="#7a5c00"&gt;phi.lab [C4]&lt;/font&gt;&lt;/i&gt;' style="shape=partialRectangle;whiteSpace=wrap;html=1;left=0;right=0;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="268" width="200" height="54" as="geometry"/></mxCell><mxCell id="c12" value="тесты" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="пациент, тесты" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="order_id, пол, возраст, тесты" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c9" target="c7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1220" y="145"/></Array></mxGeometry></mxCell><mxCell id="c15" value="результат по order_id" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1220" y="445"/></Array></mxGeometry></mxCell><mxCell id="c16" value="результат (шифр.)" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="390" y="431"/></Array></mxGeometry></mxCell><mxCell id="c17" value="в личном кабинете" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="200" y="466"/><mxPoint x="200" y="445"/></Array></mxGeometry></mxCell><mxCell id="c18" value="&lt;b&gt;🔒 Меры защиты&lt;/b&gt;&lt;br&gt;• Минимизация: партнёру передаются order_id, пол, возрастная группа и коды тестов — без ФИО и диагноза&lt;br&gt;• Partner API: mTLS + OAuth2 scopes, подпись сообщений, лаборатория видит только свои заказы (защита от BOLA)&lt;br&gt;• Поля API-контракта размечены тегами классификации — новые интеграции проверяются автоматически&lt;br&gt;• Договор поручения обработки ПДн с лабораторией (152-ФЗ ст. 6 ч. 3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#3d1f5c;fontSize=10;align=left;spacingLeft=4;arcSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="540" width="1290" height="98" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>