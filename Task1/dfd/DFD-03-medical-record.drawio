<mxfile host="drawio" type="device"><diagram id="DFD-03" name="DFD-03"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="DFD-03. Приём у специалиста и электронная медкарта" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="10" y="0" width="1320" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Карту видит только лечащий врач; пациент видит свои заключения в личном кабинете." style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="10" y="32" width="1320" height="24" as="geometry"/></mxCell><mxCell id="c4" value="Защищённый контур (облако / ЦОД в РФ)" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#82b366;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=8;fontColor=#4d7a3a;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="70" width="830" height="440" as="geometry"/></mxCell><mxCell id="c5" value="Медицинский&lt;br&gt;специалист" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="115" width="150" height="60" as="geometry"/></mxCell><mxCell id="c6" value="Пациент" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="415" width="150" height="60" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;3.1&lt;/b&gt;&lt;br&gt;Проверка доступа&lt;br&gt;«лечащий врач?»" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="110" width="190" height="70" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;3