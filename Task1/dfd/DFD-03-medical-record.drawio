ryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="заключение" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="свои документы" style="html=1;endArrow=block;endFill=1;strokeColor=#6a3d9a;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c9" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="&lt;b&gt;🔒 Меры защиты&lt;/b&gt;&lt;br&gt;• ABAC: карту открывает только врач с активной записью пациента; экстренный доступ — с обоснованием и алертом&lt;br&gt;• Диагнозы и анамнез шифруются на уровне полей, ключ на пациента (Vault)&lt;br&gt;• Записи версионируются и подписываются УКЭП врача&lt;br&gt;• Пациент видит только свои данные (patient_id из токена); push без диагноза&lt;br&gt;• DLP на АРМ врача: запрет USB, контроль печати" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#3d1f5c;fontSize=10;align=left;spacingLeft=4;arcSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="540" width="1290" height="115" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>